 <config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
 <acl>
     <resources>
         <resource id="Magento_Backend::admin">
            <resource id="Avinash_EmailSender::emailsender" title="Email Sender" translate="title" sortOrder="30">
                <resource id="Avinash_EmailSender::sendemail" title="Send Email" translate="title" sortOrder="10" />
                <resource id="Avinash_EmailSender::logs" title="Check Logs" translate="title" sortOrder="10" />
                <resource id="Avinash_EmailSender::senddata" title="Send Data" translate="title" sortOrder="30" />
            </resource>
            <resource id="Magento_Backend::stores">
                <resource id="Magento_Backend::stores_settings">
                    <resource id="Avinash_EmailSender::config_setting" title="Email Sender Config" translate="title" />
                </resource>
             </resource>
         </resource>
     </resources>
 </acl>
</config>