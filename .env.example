# ---------------------------------------------------------------
# Bulk Mailer configuration. Copy to .env and adjust.
# ---------------------------------------------------------------

APP_NAME="SMTP MAIL BULK MAIL - SERVER"
APP_ENV=production
APP_DEBUG=false

# 32-byte key, base64 encoded. Generate with:  php bin/generate-key.php
APP_KEY=

# MySQL
# localhost = local Unix socket (recommended). Use an IP/hostname for a remote server.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bulk_mailer
DB_USER=bulk_mailer
DB_PASS=change-this-password
# Optional full PDO DSN override (e.g. for tests). When set, DB_HOST/PORT/NAME are ignored.
DB_DSN=

# Where per-user temporary workspaces live (must be writable, NOT inside public/)
STORAGE_PATH=storage

# PHP CLI binary used to launch background sending workers
PHP_CLI_BINARY=/usr/bin/php8.5

# Server-wide ceiling on simultaneous SMTP sends across ALL users (0 = no ceiling).
# This protects the server (sockets / file descriptors / CPU). Each user's own
# Send Limit is still their choice; if the server is near the ceiling, a new
# campaign gets the remaining capacity and the dashboard shows the effective limit.
SERVER_MAX_CONCURRENT_SENDS=500

# Max upload size for recipient files, in MB
UPLOAD_MAX_MB=200

# Keep finished campaign results (for the failed-email table / export) this many hours
JOB_RETENTION_HOURS=24

# Session lifetime (minutes)
SESSION_LIFETIME=480
