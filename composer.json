{
    "name": "bulk-mailer/app",
    "description": "Concurrent bulk email sender (PHP + MySQL)",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "ext-xmlreader": "*",
        "ext-zip": "*",
        "egulias/email-validator": "^4.0",
        "openspout/openspout": "^5.13",
        "symfony/mime": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform-check": true
    }
}
