{
    "name": "bulk-mailer/app",
    "description": "Concurrent bulk email sender (PHP + MySQL)",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "symfony/mime": "^7.0",
        "openspout/openspout": "^4.24",
        "egulias/email-validator": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
